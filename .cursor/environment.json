{
  "name": "DeepGuard AI",
  "install": "./scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": "cd backend && ../.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "description": "FastAPI backend on port 8000"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0 --port 5173",
      "description": "Vite React frontend on port 5173"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    },
    {
      "name": "web",
      "port": 5173
    }
  ]
}
